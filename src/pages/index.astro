---
import Layout from "../layouts/Layout.astro";
import SpinWheel from "../components/SpinWheel.svelte";
import {
  mapRawAgentToDomain,
  type ValorantApiResponse,
  type Agent,
} from "../lib/core/valorant";

const API_URL =
  "https://valorant-api.com/v1/agents?isPlayableCharacter=true&language=pt-BR";

let cleanAgents: Agent[] = [];
let errorMsg = "";

try {
  const response = await fetch(API_URL);
  if (!response.ok) throw new Error("API Error");
  const json = (await response.json()) as ValorantApiResponse;
  cleanAgents = json.data
    .map(mapRawAgentToDomain)
    .filter((a): a is Agent => a !== null)
    .sort((a, b) => a.name.localeCompare(b.name));
} catch (e) {
  errorMsg = "Erro ao carregar agentes.";
}
---

<Layout title="Valorant Spin Wheel">
  <main>
    <div class="header">
      <div class="line"></div>
    </div>

    {
      errorMsg ? (
        <p class="error">{errorMsg}</p>
      ) : (
        <SpinWheel client:load allAgents={cleanAgents} />
      )
    }
  </main>
</Layout>

<style>
  :global(body) {
    background: #0f1923;
    color: white;
    font-family: sans-serif;
    margin: 0;
  }
  main {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
  }
  .header {
    text-align: center;
    margin-bottom: 1rem;
  }
  h1 {
    margin: 0;
    font-size: 3rem;
    font-weight: 800;
    color: #ece8e1;
  }
  .line {
    width: 100px;
    height: 6px;
    background: #ff4655;
    margin: 0.5rem auto;
  }
</style>
